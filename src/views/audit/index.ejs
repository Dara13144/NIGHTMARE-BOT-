<%- include('../layouts/header', { title: 'Audit Logs', currentPath: '/admin/audit' }) %>

<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-black text-white tracking-wide">SYSTEM AUDIT LOGS</h2>
    <p class="text-xs text-gray-400 mt-1">Immutable administrative audit trail recording logins, inventory additions, and config edits</p>
  </div>

  <div class="bg-nightmare-card border border-nightmare-border rounded-xl shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-gray-300">
        <thead class="bg-nightmare-dark text-[11px] uppercase tracking-wider text-gray-400 border-b border-nightmare-border font-semibold">
          <tr>
            <th class="px-5 py-3.5">Timestamp</th>
            <th class="px-5 py-3.5">Admin User</th>
            <th class="px-5 py-3.5">Action</th>
            <th class="px-5 py-3.5">Target Entity</th>
            <th class="px-5 py-3.5">IP Address</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-nightmare-border/60">
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="5" class="px-5 py-8 text-center text-gray-500 text-sm">
                No administrative audit entries logged yet.
              </td>
            </tr>
          <% } %>
          <% logs.forEach(log => { %>
            <tr class="hover:bg-nightmare-dark/50 transition">
              <td class="px-5 py-4 font-mono text-xs text-gray-400">
                <%= new Date(log.created_at).toLocaleString() %>
              </td>
              <td class="px-5 py-4 font-semibold text-white text-xs">
                <%= log.admin_users ? log.admin_users.username : 'System' %>
              </td>
              <td class="px-5 py-4 text-xs font-mono text-red-400 font-bold">
                <%= log.action %>
              </td>
              <td class="px-5 py-4 text-xs text-gray-300">
                <%= log.target_entity || '—' %> <%= log.target_id ? '(' + log.target_id.slice(0, 8) + '...)' : '' %>
              </td>
              <td class="px-5 py-4 font-mono text-xs text-gray-500">
                <%= log.ip_address || '127.0.0.1' %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
