<%- include('../layouts/header', { title: 'Product Catalog', currentPath: '/admin/products' }) %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-black text-white tracking-wide">PRODUCT CATALOG</h2>
      <p class="text-xs text-gray-400 mt-1">Manage Rockstar games activation codes and transferable account products</p>
    </div>
    <button onclick="document.getElementById('newProductModal').classList.remove('hidden')" class="bg-red-700 hover:bg-red-800 text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-lg transition shadow-md shadow-red-950 flex items-center space-x-2 cursor-pointer">
      <span>+</span> <span>Add New Product</span>
    </button>
  </div>

  <!-- Products Table -->
  <div class="bg-nightmare-card border border-nightmare-border rounded-xl shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-gray-300">
        <thead class="bg-nightmare-dark text-[11px] uppercase tracking-wider text-gray-400 border-b border-nightmare-border font-semibold">
          <tr>
            <th class="px-5 py-3.5">Image</th>
            <th class="px-5 py-3.5">Product Title</th>
            <th class="px-5 py-3.5">Type</th>
            <th class="px-5 py-3.5">Platform / Region</th>
            <th class="px-5 py-3.5">Price</th>
            <th class="px-5 py-3.5">Stock</th>
            <th class="px-5 py-3.5">Status</th>
            <th class="px-5 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-nightmare-border/60">
          <% if (products.length === 0) { %>
            <tr>
              <td colspan="8" class="px-5 py-8 text-center text-gray-500 text-sm">
                No products found. Click "Add New Product" to populate your catalog.
              </td>
            </tr>
          <% } %>
          <% products.forEach(p => { %>
            <tr class="hover:bg-nightmare-dark/50 transition">
              <td class="px-5 py-3">
                <img src="<%= p.image_url || '/images/default-product.png' %>" alt="" class="w-12 h-12 object-cover rounded-lg border border-nightmare-border bg-black">
              </td>
              <td class="px-5 py-4 font-bold text-white text-sm">
                <%= p.title %>
                <div class="text-[11px] text-gray-500 font-normal line-clamp-1"><%= p.description || 'No description' %></div>
              </td>
              <td class="px-5 py-4">
                <% if (p.type === 'rockstar_account') { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-purple-950 text-purple-400 border border-purple-800">Account</span>
                <% } else { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-blue-950 text-blue-400 border border-blue-800">Code</span>
                <% } %>
              </td>
              <td class="px-5 py-4 text-xs text-gray-400">
                <%= p.platform %> • <%= p.region %>
              </td>
              <td class="px-5 py-4 font-bold text-emerald-400">
                $<%= Number(p.price).toFixed(2) %>
              </td>
              <td class="px-5 py-4">
                <% if (p.stock > 0) { %>
                  <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800">
                    <%= p.stock %> Available
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-red-950 text-red-400 border border-red-800">
                    Out of Stock
                  </span>
                <% } %>
              </td>
              <td class="px-5 py-4">
                <span class="text-xs <%= p.is_active ? 'text-emerald-400' : 'text-gray-500' %>">
                  <%= p.is_active ? 'Active' : 'Disabled' %>
                </span>
              </td>
              <td class="px-5 py-4 text-right space-x-2">
                <form action="/admin/products/<%= p.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this product and its inventory?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="text-xs text-red-500 hover:text-red-400 font-semibold cursor-pointer">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Product Modal -->
<div id="newProductModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-nightmare-dark border border-nightmare-border rounded-xl max-w-xl w-full p-6 shadow-2xl overflow-y-auto max-h-[90vh]">
    <div class="flex items-center justify-between pb-4 border-b border-nightmare-border">
      <h3 class="text-lg font-bold text-white">Create Rockstar Product</h3>
      <button onclick="document.getElementById('newProductModal').classList.add('hidden')" class="text-gray-500 hover:text-white">&times;</button>
    </div>

    <form action="/admin/products" method="POST" class="mt-4 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Product Title</label>
        <input type="text" name="title" required placeholder="e.g. Grand Theft Auto V - Premium Edition" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Product Type</label>
          <select name="type" required class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
            <option value="rockstar_code">Rockstar Activation Code</option>
            <option value="rockstar_account">Rockstar Account</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Price (USD)</label>
          <input type="number" step="0.01" min="0.01" name="price" required placeholder="14.99" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Platform</label>
          <input type="text" name="platform" value="PC / Rockstar Launcher" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Region</label>
          <input type="text" name="region" value="Global / Region-Free" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Description</label>
        <textarea name="description" rows="2" placeholder="Product details..." class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white"></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Features (Comma separated)</label>
        <input type="text" name="features" placeholder="Includes Online Criminal Enterprise, Story Mode, Full Warranty" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Product Image URL</label>
        <input type="text" name="image_url" placeholder="https://... or upload below" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
      </div>

      <div class="flex justify-end space-x-3 pt-4 border-t border-nightmare-border">
        <button type="button" onclick="document.getElementById('newProductModal').classList.add('hidden')" class="px-4 py-2 bg-nightmare-card hover:bg-nightmare-border text-gray-300 text-xs font-semibold rounded">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-red-700 hover:bg-red-800 text-white text-xs font-bold rounded uppercase tracking-wider">Save Product</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
