<%- include('../layouts/header', { title: 'Promotions & Coupons', currentPath: '/admin/promotions' }) %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-black text-white tracking-wide">PROMOTIONS & COUPONS</h2>
      <p class="text-xs text-gray-400 mt-1">Configure discount codes applied during bot checkout</p>
    </div>
    <button onclick="document.getElementById('newPromoModal').classList.remove('hidden')" class="bg-red-700 hover:bg-red-800 text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-lg transition shadow-md shadow-red-950 flex items-center space-x-2 cursor-pointer">
      <span>+</span> <span>Create Promo Code</span>
    </button>
  </div>

  <div class="bg-nightmare-card border border-nightmare-border rounded-xl shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-gray-300">
        <thead class="bg-nightmare-dark text-[11px] uppercase tracking-wider text-gray-400 border-b border-nightmare-border font-semibold">
          <tr>
            <th class="px-5 py-3.5">Promo Code</th>
            <th class="px-5 py-3.5">Discount</th>
            <th class="px-5 py-3.5">Description</th>
            <th class="px-5 py-3.5">Usage Count</th>
            <th class="px-5 py-3.5">Status</th>
            <th class="px-5 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-nightmare-border/60">
          <% if (promotions.length === 0) { %>
            <tr>
              <td colspan="6" class="px-5 py-8 text-center text-gray-500 text-sm">
                No active promo codes. Click "Create Promo Code" to launch a campaign.
              </td>
            </tr>
          <% } %>
          <% promotions.forEach(promo => { %>
            <tr class="hover:bg-nightmare-dark/50 transition">
              <td class="px-5 py-4 font-mono font-bold text-red-400 text-sm">
                <%= promo.code %>
              </td>
              <td class="px-5 py-4 font-bold text-emerald-400">
                <%= promo.discount_percent %>% OFF
              </td>
              <td class="px-5 py-4 text-xs text-gray-300">
                <%= promo.description || '—' %>
              </td>
              <td class="px-5 py-4 text-xs text-gray-400">
                <%= promo.used_count || 0 %> <%= promo.max_uses ? '/ ' + promo.max_uses : 'uses' %>
              </td>
              <td class="px-5 py-4">
                <span class="text-xs <%= promo.is_active ? 'text-emerald-400' : 'text-gray-500' %>">
                  <%= promo.is_active ? 'Active' : 'Disabled' %>
                </span>
              </td>
              <td class="px-5 py-4 text-right">
                <form action="/admin/promotions/<%= promo.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this promotion code?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="text-xs text-red-500 hover:text-red-400 font-semibold cursor-pointer">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Promo Code Modal -->
<div id="newPromoModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-nightmare-dark border border-nightmare-border rounded-xl max-w-md w-full p-6 shadow-2xl">
    <div class="flex items-center justify-between pb-4 border-b border-nightmare-border">
      <h3 class="text-lg font-bold text-white">Create Promo Code</h3>
      <button onclick="document.getElementById('newPromoModal').classList.add('hidden')" class="text-gray-500 hover:text-white">&times;</button>
    </div>

    <form action="/admin/promotions" method="POST" class="mt-4 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Coupon Code (Uppercase)</label>
        <input type="text" name="code" required placeholder="e.g. NIGHTMARE10" class="w-full font-mono uppercase px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Discount Percentage (%)</label>
        <input type="number" step="0.5" min="1" max="100" name="discount_percent" required placeholder="10" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Description</label>
        <input type="text" name="description" placeholder="Launch discount 10% off" class="w-full px-3 py-2 bg-nightmare-card border border-nightmare-border rounded text-sm text-white">
      </div>

      <div class="flex justify-end space-x-3 pt-4 border-t border-nightmare-border">
        <button type="button" onclick="document.getElementById('newPromoModal').classList.add('hidden')" class="px-4 py-2 bg-nightmare-card hover:bg-nightmare-border text-gray-300 text-xs font-semibold rounded">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-red-700 hover:bg-red-800 text-white text-xs font-bold rounded uppercase tracking-wider">Create Coupon</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
