# Server Configuration
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Telegram Bot Configuration
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
ADMIN_TELEGRAM_IDS=123456789,987654321

# Supabase PostgreSQL & Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Security & Sessions
SESSION_SECRET=a_very_long_random_session_secret_change_in_production_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ABA PayWay Payment Gateway
# Note: Ensure ABA PayWay merchant account is active and credentials are obtained from ABA merchant portal
ABA_PAYWAY_MERCHANT_ID=ec438921
ABA_PAYWAY_API_KEY=your_aba_payway_api_key_here
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_CALLBACK_SECRET=your_callback_hmac_secret_if_configured

# CutLuy Bakong KHQR Payment Gateway
CUTLUY_API_KEY=your_cutluy_api_key_here
CUTLUY_WEBHOOK_SECRET=your_cutluy_webhook_secret_here
CUTLUY_BASE_URL=https://cutluy.com

# Logging
LOG_LEVEL=info
